{
    "variables":
    {
        "bg":          "#222222",
        "fg":          "#ffffcc",
        "grey":        "#aaaaaa",
        "yellow":      "#ffff00",
        "caret_green": "#00ff00",
        "red":         "#ff0000"
    },

    "globals":
    {
        "background":                "var(bg)",
        "foreground":                "var(fg)",
        "caret":                     "var(caret_green)",
        "invisibles":                "#ffffff",
        "line_highlight":            "#444444",

        "selection":                 "#777777",
        "selection_border":          "#ffffff",
        //"inactive_selection":        "#000000", // The ctrl+i ends up this colour... for some reason

        "find_highlight":            "#000000",
        "find_highlight_foreground": "#ffffff",

        // Outline around other occurrences of the selected text. Dormant while
        // match_selection is false -- but keep it: delete this line and Sublime
        // goes back to synthesising the colour, which is what made those boxes
        // green. One line to keep the behaviour pinned if you re-enable it.
        "highlight":                 "#ffffff",

        "misspelling":               "var(red)",
        "accent":                    "var(yellow)",

        "guide":                     "#444444",
        "stack_guide":               "#888888",
        "active_guide":              "#ffffff"
    },

    "rules":
    [
        // ---- base theme -------------------------------------------------
        { "name": "Comment", "scope": "comment", "foreground": "var(yellow)", "font_style": "" },
        { "name": "String",  "scope": "string",  "foreground": "var(grey)" },

        // ---- Region colours ---------------------------------------------
        // Sublime SYNTHESISES any region.*ish not defined here, guessing from
        // the scheme's palette. This palette is sparse, so the guesses were bad
        // -- that was the red-braces bug. Do NOT trim these even where a colour
        // looks unused: removing one brings the guessing back for that hue.
        { "scope": "region.redish",    "foreground": "#ff0000" },
        { "scope": "region.orangish",  "foreground": "#ffaa00" },
        { "scope": "region.yellowish", "foreground": "#ffff00" },
        { "scope": "region.greenish",  "foreground": "#1f5030" },
        { "scope": "region.cyanish",   "foreground": "#00cdcd" },
        { "scope": "region.bluish",    "foreground": "#5c5cff" },
        { "scope": "region.purplish",  "foreground": "#cd00cd" },
        { "scope": "region.pinkish",   "foreground": "#ff69b4" },

        // ---- BracketHighlighter -----------------------------------------
        // Paired with bracket_styles in bh_core.sublime-settings, which points
        // every bracket type at brackethighlighter.all. BH draws "underline"
        // for matched and "outline" for unmatched; both use foreground only, so
        // add a "background" here only if you switch a style to "solid".
        { "name": "Bracket Highlighter - All",       "scope": "brackethighlighter.all",       "foreground": "var(yellow)" },
        { "name": "Bracket Highlighter - Unmatched", "scope": "brackethighlighter.unmatched", "foreground": "var(red)" },

        // ---- SublimeLinter ----------------------------------------------
        // region.redish is pinned above and deliberately left out of this rule
        // -- sharing it was what made BH and SublimeLinter interfere.
        { "name": "Linter Error", "scope": "region.error, sublimelinter.mark.error", "foreground": "var(red)" }
    ]
}