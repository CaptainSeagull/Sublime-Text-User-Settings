{
    "variables":
    {
        "bg":          "#1E1F22",
        "fg":          "#FCFCCC",
        "comment":     "#93C0F7",
        "string":      "#A8D69A",
        "caret":       "#FF3B30",
        "red":         "#FF3B30",
        "mark":        "#7A808A",
        "ghost":       "#5A5E66",
        "note_pop":    "#A8D69A",
        "todo_pop":    "#FFD54F"
    },

    "globals":
    {
        "background":                "var(bg)",
        "foreground":                "var(fg)",
        "caret":                     "var(caret)",
        "invisibles":                "var(ghost)",
        "line_highlight":            "#2A2C31",

        "selection":                 "#3D4552",
        "selection_border":          "#666A72",

        "find_highlight":            "#3D4552",
        "find_highlight_foreground": "var(fg)",

        "highlight":                 "#666A72",

        "misspelling":               "var(red)",
        "accent":                    "var(comment)",

        "brackets_options":          "underline",
        "brackets_foreground":       "var(caret)",
        "bracket_contents_options":  "none",
        "bracket_contents_foreground": "var(fg)",

        "guide":                     "#44474D",
        "stack_guide":               "#666A72",
        "active_guide":              "#93C0F7"
    },

    "rules":
    [
        // ---- base theme (theme-claude-blue) ---------------------------
        // Comment body + // /* */ markers (markers are also punctuation.* and must win).
        { "name": "Comment", "scope": "comment, punctuation.definition.comment", "foreground": "var(comment)", "font_style": "" },
        // String body + " ' quotes (quotes are also punctuation.* and must win).
        { "name": "String", "scope": "string, punctuation.definition.string", "foreground": "var(string)" },
        { "name": "Keyword", "scope": "keyword, storage.type, storage.modifier", "foreground": "var(fg)" },
        { "name": "Constant", "scope": "constant.numeric, constant.language, constant.character, constant.other", "foreground": "var(fg)" },
        { "name": "Preprocessor", "scope": "meta.preprocessor, keyword.control.import", "foreground": "var(fg)" },
        { "name": "Include path", "scope": "string.quoted.other.lt-gt.include, punctuation.definition.string.begin.include, punctuation.definition.string.end.include", "foreground": "var(string)" },
        { "name": "Functions", "scope": "entity.name.function, variable.function, support.function", "foreground": "var(fg)" },
        // Off-yellow; exclude comment/string so // and " aren't stolen by this rule.
        {
            "name": "Brackets and punctuation",
            "scope": "punctuation - comment - string, punctuation.section - comment - string, meta.brace, meta.brackets, meta.parens, meta.block",
            "foreground": "var(fg)"
        },

        // ---- Region colours ---------------------------------------------
        { "scope": "region.redish",    "foreground": "#ff0000" },
        { "scope": "region.orangish",  "foreground": "#ffaa00" },
        { "scope": "region.yellowish", "foreground": "#ffff00" },
        { "scope": "region.greenish",  "foreground": "#1f5030" },
        { "scope": "region.cyanish",   "foreground": "#00cdcd" },
        { "scope": "region.bluish",    "foreground": "#5c5cff" },
        { "scope": "region.purplish",  "foreground": "#cd00cd" },
        { "scope": "region.pinkish",   "foreground": "#ff69b4" },

        // ---- BracketHighlighter -----------------------------------------
        { "name": "Bracket Highlighter - All",       "scope": "brackethighlighter.all",       "foreground": "var(comment)" },
        { "name": "Bracket Highlighter - Unmatched", "scope": "brackethighlighter.unmatched", "foreground": "var(red)" },

        // ---- SublimeLinter ----------------------------------------------
        { "name": "Linter Error", "scope": "region.error, sublimelinter.mark.error", "foreground": "var(red)" }
    ]
}
